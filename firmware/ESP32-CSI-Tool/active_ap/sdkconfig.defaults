# active_sta ile aynı zorunlu ayarlar (docs/RuView_CSI_Proje_Plani.md Faz 1)

# Serial flasher config > 'idf.py monitor' baud rate > Custom Baud Rate = 921600
CONFIG_ESPTOOLPY_MONITOR_BAUD_OTHER=y
CONFIG_ESPTOOLPY_MONITOR_BAUD_OTHER_VAL=921600
CONFIG_MONITOR_BAUD_OTHER=y
CONFIG_MONITOR_BAUD_OTHER_VAL=921600

# Component config > Common ESP32-related > Channel for console output > Custom UART, baud 921600
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_CONSOLE_UART_CUSTOM=y
CONFIG_CONSOLE_UART_BAUDRATE=921600

# Component config > Wi-Fi > WiFi CSI (Channel State Information)
CONFIG_ESP32_WIFI_CSI_ENABLED=y

# Component config > FreeRTOS > Tick rate (Hz)
CONFIG_FREERTOS_HZ=1000

# Bu kart (B) sadece kendi erisim noktasini (AP) yayinlar, CSI TOPLAMAZ.
# Sebep: Kconfig notu - "Allowing only a single ESP32 to collect CSI will
# likely increase the sampling frequency" -> tum CSI toplama isini STA
# (laptopa bagli, orijinal kart A) yapar, B sadece sabit bir ag saglar.
CONFIG_SHOULD_COLLECT_CSI=n

# Ozel AP - gercek bir wifi sifresi degil, kendi kurdugumuz sabit test agi.
# Bu yuzden sdkconfig.defaults.local'e degil, buraya (commit edilen dosyaya)
# yazildi.
CONFIG_WIFI_CHANNEL=6
CONFIG_ESP_WIFI_SSID="ESP32_CSI_AP"
CONFIG_ESP_WIFI_PASSWORD="csitool123"
